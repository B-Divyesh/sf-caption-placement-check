{
  "name": "caption-placement-check",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.app.config.ts",
    "dev:site": "vite --config vite.config.ts",
    "tauri": "tauri",
    "build": "npm run build:site",
    "build:site": "vite build --config vite.config.ts && vite build --config vite.app.config.ts && mkdir -p dist/site/check dist/site/demo && cp -R dist/app/. dist/site/check/ && cp -R dist/app/. dist/site/demo/",
    "build:app": "vite build --config vite.app.config.ts",
    "test": "vitest run",
    "test:benchmark": "vitest run tests/benchmark.test.ts && playwright test tests/e2e/benchmark.spec.ts",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.1",
    "typescript": "5.9.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
