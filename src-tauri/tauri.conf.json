{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caption Placement Check",
  "version": "0.1.4",
  "identifier": "in.sociobot.caption-placement-check",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist/app"
  },
  "app": {
    "windows": [
      {
        "title": "Caption Placement Check",
        "width": 1280,
        "height": 820,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#101313"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; media-src 'self' asset: blob:; connect-src 'self' https://api.sociobot.in; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Check caption placement locally",
    "longDescription": "Review SRT and WebVTT caption placement against faces and dense visual regions without uploading media.",
    "copyright": "Copyright © 2026 Sociobot",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
